{
  "name": "DownAttack",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node infra/scripts/seed.js && nuxt build",
    "dev": "npm run services:up && npm run services:wait:database && npm run migrations:up && (trap 'npm run services:stop' INT TERM ; nuxt dev)",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "nuxt prepare && eslint . --max-warnings 0",
    "lint:eslint:fix": "npx eslint . --fix",
    "commit": "cz",
    "test": "npm run services:up && concurrently -n nuxt,jest --hide nuxt -k -s command-jest \"nuxt dev\" \"jest --runInBand --verbose\"",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "migrations:create": "node-pg-migrate -m infra/migrations create",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env  up",
    "migrations:up:dry": "node-pg-migrate -m infra/migrations --envPath .env --dry-run up",
    "prepare": "husky",
    "db:seed": "npm run services:up && npm run services:wait:database && node --env-file=.env infra/scripts/seed.js",
    "db:save-seed": "node infra/scripts/save-seed.js",
    "user:admin": "node infra/scripts/grant-admin.js",
    "solare:seed": "node --env-file=.env infra/scripts/seed-solare.js",
    "solare:seed-anchors": "node --env-file=.env infra/scripts/seed-solare-rating-anchors.js",
    "solare:win": "node --env-file=.env infra/scripts/seed-solare.js --match",
    "solare:loss": "node --env-file=.env infra/scripts/seed-solare.js --match --loss"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@nuxt/icon": "^2.5.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "async-retry": "1.3.3",
    "node-pg-migrate": "9.0.0",
    "nuxt": "4.5.2",
    "pg": "8.23.0",
    "satori": "^0.63.2",
    "uuid": "^14.0.2",
    "vue": "3.5.42",
    "vue-router": "5.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/css": "2.0.0",
    "@eslint/js": "9.39.5",
    "@eslint/json": "2.1.0",
    "@eslint/markdown": "8.0.3",
    "@faker-js/faker": "^10.6.0",
    "@nuxt/eslint": "1.17.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@swc/core": "1.16.2",
    "@swc/jest": "0.2.39",
    "autoprefixer": "^10.6.1",
    "concurrently": "10.0.5",
    "cz-conventional-changelog": "3.3.0",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^1000.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jest": "^30.5.1",
    "postcss": "^8.5.28",
    "prettier": "3.9.6",
    "secretlint": "13.0.5",
    "set-cookie-parser": "^3.1.2",
    "tailwindcss": "^3.4.19"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": "24"
  }
}
